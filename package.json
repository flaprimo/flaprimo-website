{
  "name": "flaprimo-website",
  "description": "Flavio Primo website",
  "version": "2.0.0",
  "author": "Flavio Primo",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:build": "node scripts/check-build.mjs",
    "check:highlight": "node scripts/check-highlighting.mjs",
    "check:worker": "bash scripts/check-worker.sh",
    "deploy": "astro build && wrangler deploy",
    "test": "npm run check && npm run build && npm run check:build && npm run check:highlight && npm run check:worker",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.124.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flaprimo/flaprimo-website"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true
  }
}
