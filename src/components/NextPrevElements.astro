---
interface Neighbour {
  href: string;
  title: string;
}

interface Props {
  previous?: Neighbour;
  next?: Neighbour;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav
      class="border-line mt-12 grid gap-4 border-t pt-8 sm:grid-cols-2"
      aria-label="More articles"
    >
      {previous ? (
        <a
          href={previous.href}
          rel="prev"
          class="border-line bg-surface hover:border-link group flex flex-col rounded-xl border p-4 transition-colors"
        >
          <span class="text-ink-muted group-hover:text-link flex items-center gap-1 text-xs tracking-wide uppercase transition-colors">
            <span aria-hidden="true">←</span> Previous
          </span>
          <span class="text-ink-strong mt-2 font-medium">{previous.title}</span>
        </a>
      ) : (
        <div class="hidden sm:block" />
      )}

      {next && (
        <a
          href={next.href}
          rel="next"
          class="border-line bg-surface hover:border-link group flex flex-col rounded-xl border p-4 text-right transition-colors sm:col-start-2"
        >
          <span class="text-ink-muted group-hover:text-link flex items-center justify-end gap-1 text-xs tracking-wide uppercase transition-colors">
            Next <span aria-hidden="true">→</span>
          </span>
          <span class="text-ink-strong mt-2 font-medium">{next.title}</span>
        </a>
      )}
    </nav>
  )
}
