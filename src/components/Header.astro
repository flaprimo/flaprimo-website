---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header class="hero is-dark">
  <div class="hero-body">
    <div class="container">
      <h1 class="title">{title}</h1>
      <h2 class="subtitle">{subtitle}</h2>
    </div>
  </div>
</header>
