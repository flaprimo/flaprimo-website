---
import { site } from "../config";

interface Props {
  title: string;
  type: string;
}

const { title, type } = Astro.props;

// Matches the identifier disqus-react was generating, so existing threads
// keep resolving.
const identifier = `${type}-${title}`;
---

<div
  class="comments has-text-centered"
  data-comments
  data-shortname={site.disqusShortname}
  data-identifier={identifier}
  data-title={title}
>
  <button class="button is-medium" type="button" data-comments-load>
    Comments
  </button>
  <div id="disqus_thread"></div>
</div>

<noscript>
  Please enable JavaScript to view the{" "}
  <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a>
</noscript>

<script>
  const root = document.querySelector<HTMLElement>("[data-comments]");
  const button = root?.querySelector<HTMLButtonElement>("[data-comments-load]");

  button?.addEventListener(
    "click",
    () => {
      const { shortname, identifier, title } = root!.dataset;

      // Disqus reads this global when embed.js boots.
      (window as any).disqus_config = function (this: any) {
        this.page.url = window.location.href;
        this.page.identifier = identifier;
        this.page.title = title;
      };

      const script = document.createElement("script");
      script.src = `https://${shortname}.disqus.com/embed.js`;
      script.setAttribute("data-timestamp", String(Date.now()));
      script.async = true;
      document.head.appendChild(script);

      button.remove();
    },
    { once: true },
  );
</script>
