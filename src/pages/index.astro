---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout type="website">
  <div
    class="min-h-viewport flex h-full flex-col justify-end bg-white bg-cover bg-center"
    style="background-image: url('/bg_index.svg')"
  >
    <div class="max-w-bulma index-hero-text mx-auto w-full px-6 pb-5">
      <h1 class="text-[6em] leading-none font-bold text-white">FLAVIO PRIMO</h1>
      <h2 class="text-[4em] leading-tight text-white">
        Just another dev blog_
      </h2>
    </div>
  </div>
</BaseLayout>

<style>
  /* Kept as plain CSS: -webkit-text-stroke has no Tailwind utility. */
  .index-hero-text {
    text-shadow: 5px 5px 15px rgba(0, 0, 0, 0.6);
    -webkit-text-stroke: 1px black;
  }
</style>
