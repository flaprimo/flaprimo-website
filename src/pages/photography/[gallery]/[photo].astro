---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { allGalleries, photoHref, type Photo } from "../../../lib/photos";

export const getStaticPaths = async () => {
  const titles = new Map(
    (await getCollection("photography")).map((g) => [g.id, g.data.title]),
  );

  return [...allGalleries().values()].flatMap((photos) =>
    photos.map((photo, index) => ({
      params: { gallery: photo.gallery, photo: photo.name },
      props: {
        photo,
        // Gatsby put the raw URL path in the <title> here; the gallery's own
        // title is what that was reaching for.
        galleryTitle: titles.get(photo.gallery) ?? photo.gallery,
        previous: photos[index - 1],
        next: photos[index + 1],
      },
    })),
  );
};

const { photo, galleryTitle, previous, next } = Astro.props as {
  photo: Photo;
  galleryTitle: string;
  previous?: Photo;
  next?: Photo;
};

const galleryHref = `/photography/${photo.gallery}/`;

// Preload the neighbours so the arrows feel instant, as the Gatsby template did.
const preload = await Promise.all(
  [previous, next]
    .filter((p): p is Photo => Boolean(p))
    // Options must match the <Image> below, or the preload misses.
    .map((p) => getImage({ src: p.image, width: 1000, layout: "none" })),
);
---

<BaseLayout title={galleryTitle} type="article" bare>
  <Fragment slot="head">
    {preload.map((image) => <link rel="preload" as="image" href={image.src} />)}
  </Fragment>

  <div class="flex min-h-svh flex-col bg-black">
    <div class="photo-stage flex h-[90svh] items-center justify-center">
      <Image
        src={photo.image}
        alt={`${galleryTitle} — ${photo.name}`}
        width={1000}
        layout="none"
        priority
      />
    </div>

    <nav class="flex h-[10svh] items-center justify-between px-4">
      <div class="flex">
        {
          previous && (
            <a
              href={photoHref(previous)}
              class="photo-button rounded-l-md"
              aria-label="Previous photo"
            >
              <i class="arrow-icon left-arrow" />
            </a>
          )
        }
        {
          next && (
            <a
              href={photoHref(next)}
              class:list={[
                "photo-button rounded-r-md",
                !previous && "rounded-l-md",
              ]}
              aria-label="Next photo"
            >
              <i class="arrow-icon right-arrow" />
            </a>
          )
        }
      </div>

      <a
        href={galleryHref}
        class="photo-button rounded-md"
        aria-label="Back to gallery"
      >
        <i class="close-icon"></i>
      </a>
    </nav>
  </div>
</BaseLayout>

<style>
  .photo-stage :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }

  /* A dark pill button. Kept as CSS because the arrow and close glyphs are
     drawn with borders and pseudo-elements rather than an icon font. */
  .photo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: #363636;
    transition: background-color 0.2s ease;
  }

  .photo-button:hover {
    background: #4a4a4a;
  }

  /* Formerly styled-components in photoElementTemplate.js */
  .arrow-icon {
    border: solid #f5f5f5;
    padding: 4px;
    transform: rotate(45deg);
  }

  .arrow-icon.left-arrow {
    border-width: 0 0 2px 2px;
    margin-left: 3px;
  }

  .arrow-icon.right-arrow {
    border-width: 2px 2px 0 0;
    margin-right: 3px;
  }

  .close-icon {
    width: 14px;
    height: 14px;
    position: relative;
  }

  .close-icon::before,
  .close-icon::after {
    content: "";
    position: absolute;
    left: 50%;
    background: #f5f5f5;
    width: 2px;
    height: 100%;
  }

  .close-icon::before {
    transform: rotate(45deg);
  }

  .close-icon::after {
    transform: rotate(-45deg);
  }
</style>

<script>
  // Keyboard navigation, which the Gatsby version never had.
  const links = {
    ArrowLeft: document.querySelector<HTMLAnchorElement>(
      '[aria-label="Previous photo"]',
    ),
    ArrowRight: document.querySelector<HTMLAnchorElement>(
      '[aria-label="Next photo"]',
    ),
    Escape: document.querySelector<HTMLAnchorElement>(
      '[aria-label="Back to gallery"]',
    ),
  };

  document.addEventListener("keydown", (event) => {
    const link = links[event.key as keyof typeof links];
    if (link) {
      event.preventDefault();
      link.click();
    }
  });
</script>
