---
import type { InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Tags from "../../../components/Tags.astro";
import NextPrevElements from "../../../components/NextPrevElements.astro";
import { galleryPhotos, photoHref } from "../../../lib/photos";

export const getStaticPaths = async () => {
  const galleries = (await getCollection("photography")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  return galleries.map((entry, index) => ({
    params: { gallery: entry.id },
    props: {
      entry,
      previous: galleries[index + 1],
      next: galleries[index - 1],
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, previous, next } = Astro.props as Props;
const { Content } = await render(entry);

const photos = galleryPhotos(entry.id);

// Gatsby fed the 1000px-wide cover to the social card; getImage() is the
// astro:assets equivalent of childImageSharp.resize.
const card = await getImage({
  src: entry.data.cover,
  width: 1000,
  format: "jpg",
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.title}
  image={card.src}
  type="article"
>
  <Header
    title={entry.data.title}
    meta={{
      date: entry.data.date,
      category: entry.data.category,
      section: "photography",
    }}
  />

  <div class="max-w-bulma mx-auto w-full px-6 py-12">
    <article class="prose max-w-none">
      <Content />
    </article>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {
        photos.map((photo) => (
          <a
            href={photoHref(photo)}
            class="block overflow-hidden rounded-lg transition-opacity hover:opacity-80"
          >
            <Image
              src={photo.image}
              alt={`${entry.data.title} — ${photo.name}`}
              width={300}
              height={300}
              quality={85}
              layout="fixed"
              fit="cover"
            />
          </a>
        ))
      }
    </div>

    <div class="mt-8">
      <Tags tags={entry.data.tags} />
    </div>

    <NextPrevElements
      previous={previous && {
        href: `/photography/${previous.id}/`,
        title: previous.data.title,
      }}
      next={next && {
        href: `/photography/${next.id}/`,
        title: next.data.title,
      }}
    />
  </div>
</BaseLayout>
