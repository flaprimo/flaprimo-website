---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import EntryCard from "../../components/EntryCard.astro";
import { excerpt } from "../../lib/excerpt";

const contentTitle = "Photography";

const galleries = (await getCollection("photography")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title={contentTitle}
  description="Flavio's photography gallery, photos from the wonderful places I've been."
  type="website"
>
  <Header title={contentTitle} subtitle="My point of view" />

  <div class="max-w-bulma mx-auto w-full px-6 py-12">
    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
      {
        galleries.map((gallery) => (
          <EntryCard
            href={`/photography/${gallery.id}/`}
            title={gallery.data.title}
            excerpt={excerpt(gallery.body ?? "")}
            date={gallery.data.date}
            category={gallery.data.category}
            section="photography"
          >
            <Image
              slot="image"
              src={gallery.data.cover}
              alt={`${gallery.data.title} cover image`}
              width={900}
              quality={85}
              class="w-full"
            />
          </EntryCard>
        ))
      }
    </div>
  </div>
</BaseLayout>
