---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import me from "../assets/me.jpg";

const contentTitle = "About";
---

<BaseLayout
  title={contentTitle}
  description="Hi, I'm Flavio, pleased to meet you!"
  type="website"
>
  <Header title={contentTitle} subtitle="Let's talk about me" />

  <div class="max-w-bulma mx-auto w-full px-6 py-12">
    <figure class="mx-auto mb-12 max-w-sm">
      <Image src={me} alt="me" class="w-full rounded-full" width={480} />
    </figure>

    <div class="prose mx-auto">
      <p>
        I am <b>Flavio Primo</b>, an Italian Senior IT Architect at <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.bcgplatinion.com">BCG Platinion</a
        >, where I work on IT/OT integration and data strategies.
      </p>
      <p>
        I am an all around developer with a focus on Data Science and
        Engineering, with an MSc degree in Computer Science and Engineering from
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.polimi.it">Politecnico di Milano</a
        > and a second level master&#39;s degree in Cloud Data Architecture from <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.cefriel.com/en">Cefriel - Politecnico di Milano</a
        >.
      </p>
      <p>
        Previously I was a Cloud Data Architect at <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.bipconsulting.com/who-we-are/practices/x-Tech"
          >Bip xTech</a
        >.
      </p>
      <p>
        I enjoy reading news about technology and politics, watching movies and
        TV series (my favorites are SciFi and thought provoker genres),
        listening to music (pretty much anything), travelling, running, reading
        books and having Belgian ales with my friends.
      </p>
      <p>I&#39;m a firm supporter of open-source software and technologies.</p>
    </div>
  </div>
</BaseLayout>
